# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon (https://console.neon.tech)
DATABASE_URL=

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# 선택: 기본값 claude-sonnet-5-5
# CLAUDE_MODEL=claude-sonnet-5-5

# Notion 토큰 암호화 키 (32바이트 base64)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

APP_URL=http://localhost:3000

# Notion 내부 통합 토큰 (https://www.notion.so/profile/integrations)
NOTION_API_TOKEN=
# 뉴스를 저장할 데이터베이스 id 또는 URL. 데이터베이스의 ⋯ → 연결에 통합을 추가해야 한다.
# 속성: 제목(title), 요약(rich_text), 날짜(date), 출처(url), 카테고리(select)
NOTION_DATABASE_ID=
